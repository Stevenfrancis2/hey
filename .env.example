# ── Telegram ─────────────────────────────────────────────
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id. The bot ignores everyone else.
# Get it by messaging @userinfobot
TELEGRAM_OWNER_ID=
# Any random string; Telegram echoes it back so we can reject forged webhooks
TELEGRAM_WEBHOOK_SECRET=

# Signs console login sessions. MUST be set in production and MUST be different
# from the webhook secret above — that one is handed to Telegram.
#   openssl rand -hex 32
SESSION_SECRET=

# ── Database ─────────────────────────────────────────────
# Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# ── The brain (Anthropic) ────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# ── Embeddings (Voyage AI) ───────────────────────────────
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# ── Transcription (Groq Whisper) ─────────────────────────
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Google Drive + Calendar (optional) ───────────────────
# From Google Cloud Console. See docs/GOOGLE-SETUP.md — 10 minutes.
# Leave blank and everything else still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only sync one folder instead of the whole Drive.
GOOGLE_DRIVE_FOLDER_ID=

# ── Runtime ──────────────────────────────────────────────
# Set in production only. Presence of this switches the bot from
# long-polling to webhook mode.
PUBLIC_URL=
PORT=8080
TZ=Asia/Beirut

# ── Where you fly (Open-Meteo — free, no key needed) ─────
# Defaults to Beirut. Change to wherever you actually fly.
LATITUDE=33.8938
LONGITUDE=35.5018
LOCATION_NAME=Beirut, Lebanon
LOG_LEVEL=info
